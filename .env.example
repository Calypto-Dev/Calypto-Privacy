# Configure server-side with Sites runtime settings. Never put values in client code.
AI_API_KEY=
AI_MODEL=
# Provider's HTTPS base URL, including its API version path. No credentials in the URL.
AI_BASE_URL=
# Trusted HTTPS origin only (no API path). Must match AI_BASE_URL's origin.
AI_ALLOWED_ORIGIN=
# Optional JSON object of provider-specific chat options; keep actual values private.
AI_CHAT_OPTIONS_JSON={}
# Required for web research: JSON object of provider-specific search/citation options.
AI_RESEARCH_OPTIONS_JSON=
# Optional dotted response path to a citation array; standard message annotations also work.
AI_CITATIONS_PATH=
CALYPTO_TOKEN_ADDRESS=
# Use a dedicated provider for production. HOLD_LOOKBACK_SECONDS needs historical (archive) state.
# Secret keys. Alchemy is used automatically for Robinhood Mainnet RPC and wallet data.
ALCHEMY_API_KEY=
BLOCKSCOUT_API_KEY=
# Optional RPC override; leave empty to use Alchemy automatically.
RH_RPC_URL=
EXPLORER_URL=https://robinhoodchain.blockscout.com
DEXSCREENER_CHAIN_ID=robinhood
DAILY_REQUEST_LIMIT=200
# Keep the three-prompt trial enabled. Set true only for temporary open-access testing.
# Daily capacity, IP limits, and other abuse protections remain active when paused.
DISABLE_TRIAL_LIMIT=false

# Holder check hardening
MIN_LIQUIDITY_USD=1000
MAX_PRICE_MOVE_H1_PCT=1000
HOLD_LOOKBACK_SECONDS=0

# Cost control: total conversation characters sent to the model per prompt
MAX_INPUT_CHARS=24000

# Optional. Signs assistant replies so clients cannot forge them. Defaults to a key derived from AI_API_KEY.
REPLY_SIGNING_SECRET=

# Required. Random server-side secret (at least 32 characters) for anonymous visitor cookies and keyed IP hashes.
SESSION_SECRET=
